{
  "uid": "eop-request-logs",
  "title": "EOP Request Logs",
  "tags": [
    "eop",
    "logs",
    "loki"
  ],
  "description": "Logs of every EOP pod, collected into Loki by the otel-log-agent DaemonSet (US-306, ADR-026). Paste a trace_id from a SigNoz span to see exactly the log lines of that request; each line links back to its trace.",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "service_name",
          "stream": "",
          "type": 1
        },
        "definition": "label_values(service_name)",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "ERROR,CRITICAL,WARNING,WARN,INFO",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "trace_id",
        "label": "trace_id",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "description": "32-hex trace id from SigNoz or from the meta.trace_id of an API response. Empty shows every line."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "Request Logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Filter by service, level and trace_id (US-306 AC1). Click a line's TraceID link to open the trace in SigNoz (AC3).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "expr": "{service_name=~\"$service\"} | level=~\"$level\" | trace_id=~\"$trace_id.*\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error Lines per Service",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "ERROR and CRITICAL log lines per service over 5 minutes; a spike here usually matches an SLO alert.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "expr": "sum by (service_name) (count_over_time({service_name=~\".+\"} | level=~\"ERROR|CRITICAL\" [5m]))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      }
    }
  ]
}
