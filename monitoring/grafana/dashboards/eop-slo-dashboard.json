{
  "uid": "eop-slo-dashboard",
  "title": "EOP SLO Dashboard",
  "tags": ["eop", "slo", "system-health"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "custom",
        "label": "Service",
        "query": "eop-server,hpc-engine",
        "current": {
          "text": "eop-server",
          "value": "eop-server"
        },
        "options": [
          {
            "text": "eop-server",
            "value": "eop-server",
            "selected": true
          },
          {
            "text": "hpc-engine",
            "value": "hpc-engine",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Service Availability",
      "description": "Availability percentage for the selected EOP service.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time(up{job=~\"$service\"}[$__range]) * 100",
          "legendFormat": "availability %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 99 },
              { "color": "green", "value": 99.9 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests per Second",
      "description": "Incoming request rate for the selected EOP service.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(eop_requests_total{service=~\"$service\"}[5m]))",
          "legendFormat": "requests/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "P99 Request Latency",
      "description": "P99 request latency for the selected EOP service.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, service) (rate(eop_request_duration_seconds_bucket{service=~\"$service\"}[5m]))) * 1000",
          "legendFormat": "p99 latency ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Error Rate",
      "description": "Percentage of failed requests for the selected EOP service.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(eop_requests_total{service=~\"$service\",status=~\"ERROR|5..|TIMEOUT\"}[5m])) / clamp_min(sum(rate(eop_requests_total{service=~\"$service\"}[5m])), 1)) * 100",
          "legendFormat": "error rate %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 0
      }
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "Error Budget Remaining",
      "description": "Estimated remaining error budget against a 99.9% availability target.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(100 - ((1 - (sum(rate(eop_requests_total{service=~\"$service\",result=\"OK\"}[$__range])) / clamp_min(sum(rate(eop_requests_total{service=~\"$service\"}[$__range])), 1))) / 0.001 * 100), 0)",
          "legendFormat": "error budget remaining %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "green", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 6
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Average Request Latency",
      "description": "Average request latency for the selected EOP service.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(eop_request_duration_seconds_sum{service=~\"$service\"}[5m])) / clamp_min(sum(rate(eop_request_duration_seconds_count{service=~\"$service\"}[5m])), 1)) * 1000",
          "legendFormat": "avg latency ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 6
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Failed Requests",
      "description": "Failed request count grouped by service.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(eop_requests_total{status=~\"ERROR|5..|TIMEOUT\"}[5m]))",
          "legendFormat": "{{service}} failures/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 6
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "External Service Circuit Breakers",
      "description": "Circuit breaker state per external service, as seen by the API gateway (US-303 AC5, ADR-012). Closed: calls go through; Half-open: probing after the reset timeout; Open: the gateway serves cached or degraded fallbacks. With several gateway pods the worst state is shown.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (service) (eop_gateway_circuit_state)",
          "legendFormat": "{{service}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Closed",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "Half-open",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "Open",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "min": 0,
          "max": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 18
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Circuit Breaker Fallbacks and Transitions",
      "description": "Responses the gateway served without an external service (stale cache or degraded 503) and circuit state changes, per service (ADR-012 §5).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, kind) (rate(eop_gateway_fallback_responses_total[5m]))",
          "legendFormat": "{{service}} fallback {{kind}}"
        },
        {
          "refId": "B",
          "expr": "sum by (service, to_state) (increase(eop_circuit_breaker_state_transitions_total[5m]))",
          "legendFormat": "{{service}} → {{to_state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 8,
        "y": 18
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Gateway Error Rate by Version",
      "description": "Share of API gateway responses that are 5xx, per deployed version and track (US-304 AC3). The canary rollback trigger is this value above 1 % over 5 minutes for the canary track (ADR-011 §2, alert 'API gateway canary error rate above 1%').",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (version, track) (rate(eop_gateway_http_requests_total{status_class=\"5xx\"}[5m])) / sum by (version, track) (rate(eop_gateway_http_requests_total[5m]))",
          "legendFormat": "{{version}} ({{track}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 24
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Gateway P99 Latency by Version",
      "description": "P99 of the time the API gateway takes to serve a request, per version and track (US-304 AC3). Objective: < 300 ms (ADR-010 §6).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, version, track) (rate(eop_gateway_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{version}} ({{track}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 24
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Gateway Requests per Second by Version",
      "description": "Requests served per second by each version and track: shows the actual traffic split during a canary rollout or a blue-green switch (US-304 AC3, AC5).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (version, track) (rate(eop_gateway_http_requests_total[1m]))",
          "legendFormat": "{{version}} ({{track}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 24
      }
    }
  ]
}
