# EOP v1.0 production configuration (US-406 AC3, ADR-029): the ONE file to edit for ports,
# retention periods, SLO and alert thresholds and edge/registry tuning. deploy/production
# turns it into the eop-global-config ConfigMap; the Prometheus and Loki retention arguments are
# expanded from it. Change a value, then `make k8s-prod-apply` (or `kubectl apply -k
# deploy/production`).
#
# The development path (`make k8s-apply`, k8s/configmap.yaml) keeps its own copy;
# tests/smoke/test_production_config_contract.py fails if a key goes missing here or if the
# Grafana alert thresholds stop matching the values below.

# --- eop-server ports and sessions
EOP_PORT=9026
EOP_METRICS_PORT=9100
EOP_READY_PORT=9027
EOP_IDLE_TIMEOUT=30
EOP_MAX_CLIENTS=100
EOP_HEARTBEAT_INTERVAL=5
EOP_SHUTDOWN_DRAIN_MS=3000

# --- Shared node registry and failover (ADR-027)
EOP_REGISTRY_BACKEND=redis
EOP_REDIS_HOST=redis
EOP_REDIS_PORT=6379
EOP_REDIS_TIMEOUT_MS=200
EOP_REGISTRY_LEASE_TTL_MS=3000
EOP_REGISTRY_LEASE_REFRESH_MS=1000

# --- HPC engine (sidecar, ADR-027 §3) and its performance baseline (US-206)
EOP_SERVER_HOST=eop-server
EOP_HPC_METRICS_PORT=9101
OMP_NUM_THREADS=4
EOP_HPC_CENTRALITY_EXACT_MAX_NODES=10000
HPC_NODE_ID=hpc-engine
HPC_BUNKER_NAME=HPC-K8S
HPC_CAPACITY=1
EOP_HPC_BASELINE_P99_MS=6744
EOP_HPC_BASELINE_GRAPH_NODES=10000
EOP_HPC_BASELINE_BAND_PERCENT=20

# --- Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

# --- Edge devices (ADR-028): an edge node is ONLINE while seen within this many seconds
EOP_EDGE_LIVENESS_TIMEOUT=10
# Extra names or IPs in the broker's generated TLS certificate, comma-separated: the address the
# devices use to reach the device listener (e.g. the node IP for the NodePort 30883). The
# in-cluster names are always included. Ignored when the mosquitto-tls Secret is provided.
EOP_EDGE_BROKER_PUBLIC_HOSTS=
EOP_EDGE_CERT_DAYS=825

# --- Retention periods
# Prometheus keeps 35 days, so US-407's 30-day SLO window is always complete.
EOP_PROMETHEUS_RETENTION=35d
EOP_PROMETHEUS_RETENTION_SIZE=8GB
# Loki logs (US-306 AC4: at least 7 days).
EOP_LOKI_RETENTION=168h

# --- SLO targets (PRD NFRs; the dashboards and the demo read them from here)
EOP_SLO_AVAILABILITY_TARGET=0.999
EOP_SLO_SERVER_P99_SECONDS=0.2
EOP_SLO_GATEWAY_P99_SECONDS=0.3
EOP_SLO_EDGE_E2E_P99_SECONDS=0.5
EOP_SLO_MTTR_SECONDS=0.2

# --- Alert thresholds (monitoring/grafana/provisioning/alerting/, checked against these)
EOP_ALERT_ERROR_BUDGET_REMAINING_PERCENT=50
EOP_ALERT_CANARY_5XX_PERCENT=1
EOP_ALERT_EDGE_E2E_P99_SECONDS=0.5
